# FantasyHockeyAI web app. Copy to /etc/nginx/sites-available/<host>.conf, replace
# hockey.gradyserver.com with the real host, and get a certificate (see setup-nginx.sh for the
# pattern). Not installed by anything in this repo.
#
# The app binds to 127.0.0.1:8720 only, so nginx is the sole route in and TLS is never
# optional: the session cookie is Secure, and Web Push requires HTTPS.
server {
    listen 80;
    server_name hockey.gradyserver.com;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name hockey.gradyserver.com;

    ssl_certificate     /etc/letsencrypt/live/hockey.gradyserver.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hockey.gradyserver.com/privkey.pem;

    # Security headers are set by the app itself; nginx adds nothing that could conflict.
    client_max_body_size 128k;

    # A service worker controls only the scope it is served from; never cache it.
    location = /sw.js {
        proxy_pass http://127.0.0.1:8720/sw.js;
        proxy_set_header Host $host;
        add_header Cache-Control "no-cache" always;
    }

    # Chat replies stream as server-sent events: no buffering, and a read timeout long enough
    # for a specialist agent's run (the app sends a heartbeat comment every 15 s).
    location = /api/chat {
        proxy_pass http://127.0.0.1:8720;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location / {
        proxy_pass http://127.0.0.1:8720;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
    }
}
